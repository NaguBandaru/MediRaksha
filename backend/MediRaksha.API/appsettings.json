{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=LAPTOP-SKTS9CKA\\SQLEXPRESS;Database=MediRaksha-DB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "A_VERY_SECRET_KEY_FOR_JWT_THAT_IS_AT_LEAST_32_BYTES_LONG",
    "Issuer": "MediRakshaApi",
    "Audience": "MediRakshaClients",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  }
}
